# RENET assistant backend — copy to server/.env and fill in real values.
# Never commit server/.env. API keys are only ever read by this backend —
# never put them in VITE_ variables or frontend code.

# ---------- AI provider ----------
# Groq (default): create a key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here
# Model — must be one your Groq account lists at GET /openai/v1/models.
# Checked 2026-10-14: openai/gpt-oss-120b (default), openai/gpt-oss-20b, qwen/qwen3.8-27b
GROQ_MODEL=openai/gpt-oss-120b
# Max tokens the model may generate per reply (includes brief reasoning)
# AI_MAX_OUTPUT_TOKENS=1024

# Optional alternative provider: set AI_PROVIDER=anthropic and ANTHROPIC_API_KEY
# AI_PROVIDER=groq
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Optional: port for the API server (default: 8787)
# PORT=8787

# Comma-separated origins allowed to call the API (add your production domain)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# ---------- Test ride / enquiry leads ----------
# Where leads are stored (JSON Lines, owner-only permissions). Default: server/data/leads.jsonl
# Use persistent storage in production — ephemeral/serverless disks lose this file.
# LEADS_FILE=data/leads.jsonl

# Optional: POST every new lead as JSON to this URL (Zapier, Make, Google Apps
# Script, Slack workflow, CRM…) so the team is notified. Leave empty to disable.
LEAD_WEBHOOK_URL=
# Optional shared secret sent as the X-Renet-Webhook-Secret header.
LEAD_WEBHOOK_SECRET=

# Admin export: GET /api/admin/leads (or ?format=csv) with
# "Authorization: Bearer <ADMIN_TOKEN>". Must be 24+ random characters;
# the endpoint is disabled when this is empty or too short.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=

# ---------- Deployment ----------
# Set to 1 (one proxy hop) when running behind a reverse proxy/load balancer so
# rate limits use the visitor's real IP. Leave false when exposed directly.
TRUST_PROXY=false

# Rate limits per visitor IP
# CHAT_RATE_LIMIT_PER_MIN=15
# LEAD_RATE_LIMIT_PER_10_MIN=5
# Max simultaneous AI requests; extra requests get an instant "busy" reply
# CHAT_MAX_IN_FLIGHT=10
# Stop calling the AI provider when its reported remaining tokens-per-minute
# drops below this (until its window resets) — avoids 429 storms
# AI_TOKEN_HEADROOM=2500

# ---------- Serving the website from this server (optional) ----------
# Build first (npm run build in the project root), then point at dist/.
# Hashed assets get 1-year immutable caching, HTML revalidates every visit.
# Leave unset when the website is hosted on a CDN (Vercel, Netlify, Cloudflare…).
# STATIC_DIR=../dist
# Keep-alive must exceed your load balancer's idle timeout (often 60 s)
# KEEP_ALIVE_TIMEOUT_MS=65000
