# RENET website (frontend) — copy to .env.local and fill in real values.
# Everything prefixed with VITE_ is bundled into the public website,
# so never put secrets (like API keys) in this file.

# Official RENET WhatsApp number, digits only with country code, no + or spaces.
# Example format only — replace with the official number: 91XXXXXXXXXX
# The WhatsApp button stays hidden until this is set.
VITE_WHATSAPP_NUMBER=

# Optional: full URL of the assistant backend in production
# (leave empty in development — Vite proxies /api to localhost:8787).
VITE_CHAT_API_URL=
